
Manifest · XML
<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xsi:type="MailApp">
 
  <Id>b2e4d5f6-9c1a-4e7b-8d2f-3a6c7e8f9b0d</Id>
  <Version>1.0.0.1</Version>
  <ProviderName>Timsoft</ProviderName>
  <DefaultLocale>fr-FR</DefaultLocale>
  <DisplayName DefaultValue="Timsoft Signature" />
  <Description DefaultValue="Gestion centralisee des signatures email Timsoft - insertion automatique" />
  <IconUrl DefaultValue="https://gofraneab.github.io/timsoft-pfe/timsoft-logo.png" />
  <HighResolutionIconUrl DefaultValue="https://gofraneab.github.io/timsoft-pfe/timsoft-logo.png" />
  <SupportUrl DefaultValue="https://www.timsoft-group.com" />
 
  <AppDomains>
    <AppDomain>gofraneab.github.io</AppDomain>
  </AppDomains>
 
  <Hosts>
    <Host Name="Mailbox" />
  </Hosts>
 
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.1" />
    </Sets>
  </Requirements>
 
  <DefaultSettings>
    <SourceLocation DefaultValue="https://gofraneab.github.io/timsoft-pfe/addin/index.html" />
  </DefaultSettings>
 
  <Permissions>ReadWriteItem</Permissions>
 
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit" />
  </Rule>
 
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
 
    <Requirements>
      <bt:Sets DefaultMinVersion="1.3">
        <bt:Set Name="Mailbox" />
      </bt:Sets>
    </Requirements>
 
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url" />
          <ExtensionPoint xsi:type="MessageComposeCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="TimsoftGroup">
                <Label resid="GroupLabel" />
                <Control xsi:type="Button" id="TimsoftSignatureButton">
                  <Label resid="ButtonLabel" />
                  <Supertip>
                    <Title resid="ButtonLabel" />
                    <Description resid="ButtonDesc" />
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon16" />
                    <bt:Image size="32" resid="Icon32" />
                    <bt:Image size="64" resid="Icon64" />
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>TimsoftSignaturePane</TaskpaneId>
                    <SourceLocation resid="TaskpaneUrl" />
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
 
    <Resources>
      <bt:Images>
        <bt:Image id="Icon16" DefaultValue="https://gofraneab.github.io/timsoft-pfe/timsoft-logo.png" />
        <bt:Image id="Icon32" DefaultValue="https://gofraneab.github.io/timsoft-pfe/timsoft-logo.png" />
        <bt:Image id="Icon64" DefaultValue="https://gofraneab.github.io/timsoft-pfe/timsoft-logo.png" />
      </bt:Images>
      <bt:Urls>
        <bt:Url id="TaskpaneUrl" DefaultValue="https://gofraneab.github.io/timsoft-pfe/addin/index.html" />
        <bt:Url id="Commands.Url" DefaultValue="https://gofraneab.github.io/timsoft-pfe/addin/commands.html" />
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Timsoft" />
        <bt:String id="ButtonLabel" DefaultValue="Ma Signature" />
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="ButtonDesc" DefaultValue="Inserer ma signature Timsoft personnalisee" />
      </bt:LongStrings>
    </Resources>
 
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox" />
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <Runtime resid="Runtime.Url" lifetime="short">
              <Override type="javascript" resid="Runtime.Url.Javascript" />
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Runtime.Url" />
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onNewMessageComposeHandler" />
                <LaunchEvent Type="OnNewAppointmentOrganizer" FunctionName="onNewAppointmentComposeHandler" />
              </LaunchEvents>
              <SourceLocation resid="Runtime.Url" />
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Urls>
          <bt:Url id="Runtime.Url" DefaultValue="https://gofraneab.github.io/timsoft-pfe/addin/commands.html" />
          <bt:Url id="Runtime.Url.Javascript" DefaultValue="https://gofraneab.github.io/timsoft-pfe/addin/launchevent.js" />
        </bt:Urls>
      </Resources>
    </VersionOverrides>
 
  </VersionOverrides>
</OfficeApp>
 
